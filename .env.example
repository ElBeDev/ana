# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local al repo.

# Postgres. En Vercel lo agrega la integración de Neon (usa la URL con pooler).
DATABASE_URL=postgres://usuario@localhost:5432/ana_dev

# Vercel Blob (store público). Sin este valor, en desarrollo las imágenes van a public/uploads.
BLOB_READ_WRITE_TOKEN=

# Firma de la cookie de sesión. Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# Solo para `npm run seed` (crea o actualiza la cuenta admin). No hace falta en Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
